  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "npx jest -c jest.config.js --selectProjects unit",
    "test:watch": "npx jest -c jest.config.js --selectProjects unit --watch",
    "test:cov": "npx jest -c jest.config.js --selectProjects unit --coverage",
    "test:unit": "npx jest -c jest.config.js --selectProjects unit",
    "test:integration": "npx jest -c jest.config.js --selectProjects integration",
    "test:e2e": "npx jest -c jest.config.js --selectProjects e2e",
    "test:all": "npx jest -c jest.config.js",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "seed": "ts-node -r tsconfig-paths/register src/seed/seed.main.ts"
  },
